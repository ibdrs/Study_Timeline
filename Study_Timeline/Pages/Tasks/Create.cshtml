@page
@model Study_Timeline.View.Pages.Tasks.CreateModel

<h2>Add Task</h2>

<!-- TASK FORM -->
<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="CreateTaskInputModel.Title" class="form-label"></label>
        <input asp-for="CreateTaskInputModel.Title" class="form-control" />
        <span asp-validation-for="CreateTaskInputModel.Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CreateTaskInputModel.Description" class="form-label"></label>
        <textarea asp-for="CreateTaskInputModel.Description" class="form-control"></textarea>
    </div>

    <div class="mb-3 d-flex gap-4">
        <div class="form-check">
            <input class="form-check-input"
                   type="radio"
                   asp-for="CreateTaskInputModel.IsDeadline"
                   value="true"
                   id="deadlineRadio" />
            <label class="form-check-label" for="deadlineRadio">Deadline</label>
        </div>

        <div class="form-check">
            <input class="form-check-input"
                   type="radio"
                   asp-for="CreateTaskInputModel.IsDeadline"
                   value="false"
                   id="rangeRadio" />
            <label class="form-check-label" for="rangeRadio">Start & End time</label>
        </div>
    </div>

    <div class="mb-3" id="deadlineBlock">
        <label asp-for="CreateTaskInputModel.Deadline" class="form-label"></label>
        <input asp-for="CreateTaskInputModel.Deadline"
               class="form-control"
               type="datetime-local"
               step="60" />
        <span asp-validation-for="CreateTaskInputModel.Deadline" class="text-danger"></span>
    </div>

    <div id="rangeBlock">
        <div class="mb-3">
            <label asp-for="CreateTaskInputModel.StartTime" class="form-label"></label>
            <input asp-for="CreateTaskInputModel.StartTime"
                   class="form-control"
                   type="datetime-local"
                   step="60" />
        </div>

        <div class="mb-3">
            <label asp-for="CreateTaskInputModel.EndTime" class="form-label"></label>
            <input asp-for="CreateTaskInputModel.EndTime"
                   class="form-control"
                   type="datetime-local"
                   step="60" />
            <span asp-validation-for="CreateTaskInputModel.EndTime" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Category (optional)</label>
        <select asp-for="CreateTaskInputModel.SelectedCategoryId" class="form-select">
            <option value="">-- None --</option>
            @foreach (var c in Model.Categories)
            {
                <option value="@c.Id">@c.Name</option>
            }
        </select>
        <span asp-validation-for="CreateTaskInputModel.SelectedCategoryId" class="text-danger"></span>
    </div>

    <button class="btn btn-primary" type="submit">Create</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>

<!-- CATEGORY FORM (SEPARATE POST) -->
<form method="post" asp-page-handler="AddCategory" class="mt-3">
    <div class="card mb-3">
        <div class="card-body">
            <div class="fw-semibold mb-2">Add new category</div>

            <div class="mb-2">
                <input asp-for="CreateTaskInputModel.NewCategoryName"
                       class="form-control"
                       placeholder="Category name" />
                <span asp-validation-for="CreateTaskInputModel.NewCategoryName" class="text-danger"></span>
            </div>

            <div class="mb-2">
                <input asp-for="CreateTaskInputModel.NewCategoryDescription"
                       class="form-control"
                       placeholder="Description (optional)" />
            </div>

            <button class="btn btn-outline-primary" type="submit">
                Add category
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function toggleTimeInputs() {
            const isDeadline =
                    document.querySelector('input[name="CreateTaskInputModel.IsDeadline"]:checked')
                        ?.value === "true";

            document.getElementById("deadlineBlock").style.display =
                isDeadline ? "block" : "none";

            document.getElementById("rangeBlock").style.display =
                isDeadline ? "none" : "block";
        }

        document
            .querySelectorAll('input[name="CreateTaskInputModel.IsDeadline"]')
            .forEach(radio => radio.addEventListener("change", toggleTimeInputs));

        toggleTimeInputs();
    </script>
}
